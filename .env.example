# Optional Google sign-in. Copy to .env and fill in; leave it out entirely and
# the dashboard simply never shows a sign-in button.
#
# Google Cloud console -> APIs & Services -> Credentials -> Create credentials
# -> OAuth client ID -> Web application, then add the redirect URI below to
# "Authorised redirect URIs" verbatim.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:4321/api/auth/google/callback

# "Log OT" — pulls your day's timesheet from Teamwork and mails it as a Gmail
# draft (or sends it). Needs both lines below, plus Google sign-in above with the
# Gmail API enabled on the OAuth client's project and the gmail.compose and
# gmail.settings.basic scopes (https://www.googleapis.com/auth/...) on its consent
# screen — the second one is only used to read your own signature.
#
# TEAMWORK_SITE is your Teamwork hostname, e.g. yourcompany.teamwork.com.
# TEAMWORK_API_TOKEN: Teamwork -> your avatar -> Edit my details -> API & Mobile
# -> Show your token. It is personal; every teammate uses their own.
TEAMWORK_SITE=
TEAMWORK_API_TOKEN=
